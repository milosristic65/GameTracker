<UserControl x:Class="GameTrackerWPF.Views.UserControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameTrackerWPF.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:enums="clr-namespace:GameTrackerWPF.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="40"
             d:DesignWidth="800">

    <UserControl.Resources>
        <sys:Double x:Key="ControlHeight">36</sys:Double>

        <ObjectDataProvider x:Key="SortingMethods" 
                        MethodName="GetValues" 
                        ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:SortingMethod"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Border             
        BorderBrush="#373737"
        BorderThickness="0,1,0,0">

        <Grid Margin="15, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Sort by:" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <ComboBox Grid.Column="1" Margin="5,10" Height="{StaticResource ControlHeight}" 
                      ItemsSource="{Binding Source={StaticResource SortingMethods}}"
                      SelectedValue="{Binding SelectedSorting}" />

            <Button Grid.Column="2" Margin="5,10" Padding="0" 
                    Height="{StaticResource ControlHeight}" 
                    Width="{StaticResource ControlHeight}"
                    Command="{Binding ToggleSortOrderCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="Border.CornerRadius" Value="99"/>
                    </Style>
                </Button.Style>
                <ui:SymbolIcon FontSize="18" Foreground="#FAFAFA">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="ArrowUp28"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAscending}" Value="False">
                                    <Setter Property="Symbol" Value="ArrowDown28"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </Button>

            <Button Grid.Column="4" x:Name="btnAddGame" 
                    HorizontalAlignment="Right" 
                    Height="{StaticResource ControlHeight}" 
                    Content="Add Game" 
                    Command="{Binding AddGameCommand}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="ButtonForeground" Color="#18181B"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D4D4D8"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#18181B"/>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</UserControl>

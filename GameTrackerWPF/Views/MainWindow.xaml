<ui:FluentWindow x:Class="GameTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameTrackerWPF"
        xmlns:views="clr-namespace:GameTrackerWPF.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Game Tracker" Height="620" Width="1040">
    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border 
            Background="#1E1E1E">
            <ui:TitleBar Grid.Row="0"
                     Height="30"
                     Padding="8"
                     Title="Game Tracker"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />
        </Border>

        <!-- List of games -->
        <Grid Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Games}" Padding="16,16,16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="-8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:GameCard 
                                Id="{Binding Id}"    
                                Title="{Binding Title}" 
                                CoverImage="{Binding CoverImage}"
                                Playtime="{Binding Playtime}"
                                IsRunning="{Binding IsRunning}"
                                Width="230"
                                Height="420"
                                Margin="8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Controls for Adding and Sorting -->
        <views:UserControls Grid.Row="2" Background="#1E1E1E" />
    </Grid>
</ui:FluentWindow>

<Application x:Class="GameTrackerWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameTrackerWPF"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:GameTrackerWPF.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- THEME -->
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="WindowBackground" Color="#09090B"/>
            <SolidColorBrush x:Key="CardBackground" Color="#18181B"/>
            <SolidColorBrush x:Key="SurfaceBackground" Color="#27272A"/>

            <!-- Button -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#18181B"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#27272A"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3F3F46"/>

            <!-- Borders -->
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#27272A"/>

            <!-- Text -->
            <SolidColorBrush x:Key="PrimaryText" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="MutedText" Color="#A1A1AA"/>

            <!-- ComboBox -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#18181B"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#27272A"/>

            <!-- Hover / Focus -->
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#27272A"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3F3F46"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#27272A"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#6366F1"/>

            <!-- Dropdown popup -->
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#18181B"/>

            <!-- Items -->
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#18181B"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#27272A"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#27272A"/>
            <!-- END THEME -->

            <!-- Converters -->
            <converters:MinutesToTimeConverter x:Key="MinutesToTimeConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>